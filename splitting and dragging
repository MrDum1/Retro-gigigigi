
const image = document.getElementById('photo')
const imageSplitter = document.getElementById('imageSplitter');
const grid = document.getElementById('grid');

const widthInput = document.getElementById('width');
const lengthInput = document.getElementById('length');

function splitImage (imageSelector, rows, cols)
{
    const img = document.querySelector(imageSelector);

    if (!img.complete) { img.onload = () => splitImage(imageSelector, rows, cols); return; }

    grid.innerHTML = '';
    grid.style.display = 'grid';
    grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
    grid.style.gap = '4px';

    const pieceWidth = img.width / cols;
    const pieceHeight = img.height / rows;

    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');
    canvas.width = pieceWidth;
    canvas.height = pieceHeight;

    for (let r = 0; r < rows; r++)
    {
        for (let c = 0; c < cols; c++)
        {
            context.clearRect(0, 0, pieceWidth, pieceHeight);
            context.drawImage(img, c*pieceWidth, r*pieceHeight, pieceWidth, pieceHeight, 0, 0, pieceWidth, pieceHeight);
        
            const slicedImg = new Image();
            slicedImg.src = canvas.toDataURL('image/png');
            slicedImg.alt = `Piece ${r}-${c}`;
            slicedImg.style.position = 'relative';
            slicedImg.style.cursor = 'move';
            slicedImg.style.width = '100%';

            grid.appendChild(slicedImg);
        }
    }

    const items = Array.from(grid.children);

    for (let i = items.length - 1; i > 0; i--)
    {
        const j = Math.floor(Math.random() * (i+1));
        [items[i], items[j]] = [items[j], items[i]];
    }

    const fragment = document.createDocumentFragment();
    items.forEach(elem => fragment.appendChild(elem));
    grid.innerHTML = '';
    grid.appendChild(fragment);
}

imageSplitter.addEventListener('click', () => {
    if (!image.src == '') { splitImage('#photo', widthInput.valueAsNumber, lengthInput.valueAsNumber); pieceDragging(); image.hidden = true; } else { return; }
});

function pieceDragging()
{
    let isDragging = false;
    let offsetx, offsety;

    const items = Array.from(grid.children);
    let mouseOver = new Array(items.length).fill(false);
    let draggedItem = '';
    let firstClick = new Array(items.length).fill(true);
    let startingposX = new Array(items.length).fill(0), startingposY = new Array(items.length).fill(0);

    for (n = 0; n < items.length; n++)
    {
        const item = items[n];

        item.addEventListener('mouseenter', (e) => {
            if (isDragging) { return; }
            mouseOver[items.findIndex(index => index === e.currentTarget)] = true;
            e.currentTarget.style.zIndex = '9999';
            draggedItem = e.currentTarget;
        });

        item.addEventListener('mouseleave', (e) => {
            if (isDragging) { return; }
            mouseOver[items.findIndex(index => index === draggedItem)] = false;
            e.currentTarget.style.zIndex = '1';
            draggedItem = '';
        });

        item.addEventListener('mousedown', (e) => {
            if (!mouseOver[items.findIndex(index => index === draggedItem)]) { return; }
            isDragging = true;
            let rect = draggedItem.getBoundingClientRect();
            if (firstClick[items.findIndex(index => index === draggedItem)]) { startingposX[items.findIndex(index => index === draggedItem)] = e.pageX; startingposY[items.findIndex(index => index === draggedItem)] = e.pageY; firstClick[items.findIndex(index => index === draggedItem)] = false; }
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!draggedItem) { return; }
            if (!isDragging) { return; }
            draggedItem.style.transform = `translate(${e.pageX-startingposX[[items.findIndex(index => index === draggedItem)]]}px, ${e.pageY-startingposY[[items.findIndex(index => index === draggedItem)]]}px)`;
        });
    }
    document.addEventListener('mouseup', () => {
            isDragging = false;
    });
}